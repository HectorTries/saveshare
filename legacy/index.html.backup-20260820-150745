    localStorage.setItem('snowball_charges', charges);
    localStorage.setItem('snowball_crushed', crushed);
    localStorage.setItem('snowball_totalSaved', totalSaved);
  }

  // Load from localStorage or use demo data
  let debts = JSON.parse(localStorage.getItem('snowball_debts')) || [
    { id:1, name:'Mortgage',     balance:185000, original:185000, rate:4.2,  termMonths:300 },
    { id:2, name:'Student Loan', balance:24500,  original:24500,  rate:5.5,  termMonths:180 },
    { id:3, name:'Credit Card',  balance:4200,   original:4200,   rate:24.9, termMonths:36 },
    { id:4, name:'Car Loan',     balance:9800,   original:9800,   rate:7.9,  termMonths:48 },
    { id:5, name:'Personal Loan',balance:6500,   original:6500,   rate:11.4, termMonths:36 },
  ];
  let nextId = Math.max(5, ...debts.map(d => d.id + 1));
  let banked = parseInt(localStorage.getItem('snowball_banked')) || 3;
  let charges = parseInt(localStorage.getItem('snowball_charges')) || 1;
  let crushed = parseInt(localStorage.getItem('snowball_crushed')) || 0;
  let totalSaved = parseFloat(localStorage.getItem('snowball_totalSaved')) || 0;
  let isDemo = !localStorage.getItem('snowball_debts');

  const lineEl = document.getElementById('debtLine');
  const selectEl = document.getElementById('debtSelect');
  const amountEl = document.getElementById('amountInput');
  const logBtn = document.getElementById('logBtn');
  const wrapEl = document.getElementById('pageWrap');
  const auroraEl = document.getElementById('aurora');
  const forecastEl = document.getElementById('forecast');
  const demoTag = document.getElementById('demoTag');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const CRACK_VARIANTS = [
    ['M50 0 L46 30 M50 0 L60 22', 'M0 50 L28 46 M0 50 L24 60', 'M100 55 L72 50 M100 55 L76 62', 'M40 100 L44 72 M40 100 L54 78'],
    ['M20 0 L30 26 M20 0 L10 20', 'M100 30 L70 34 M100 30 L74 44', 'M60 100 L56 70 M60 100 L46 80', 'M0 70 L26 66 M0 70 L22 80'],
    ['M50 0 L50 24 M50 0 L34 16', 'M100 20 L74 26 M100 20 L80 10', 'M90 100 L70 82 M90 100 L82 90', 'M0 40 L22 38 M0 40 L18 26']
  ];
  const CONFETTI_COLORS = ['#F2B84B','#5FC9A8','#3E92CC','#FF6B4A','#FFFFFF'];

  function svgNS(tag){ return document.createElementNS('http://www.w3.org/2000/svg', tag); }

  function buildCracks(id){
    const svg = svgNS('svg');
    svg.setAttribute('viewBox','0 0 100 100');
    svg.setAttribute('preserveAspectRatio','none');
    svg.classList.add('cracks');
    const variant = CRACK_VARIANTS[id % CRACK_VARIANTS.length];
    variant.forEach(d=>{
      const p = svgNS('path'); p.setAttribute('d', d); p.setAttribute('pathLength','100');
      svg.appendChild(p);
    });
    return svg;
  }

  function sortDebts(){ debts.sort((a,b)=> a.balance - b.balance || a.original - b.original); }

  function weatherLabel(pctPaid){
    if(pctPaid>=100) return '☀️ Forecast: endless summer';
    if(pctPaid>=90) return '🌤️ Forecast: clear skies';
    if(pctPaid>=65) return '⛅ Forecast: mostly clear';
    if(pctPaid>=35) return '🌥️ Forecast: clearing up';
    if(pctPaid>=12) return '🌨️ Forecast: snow flurries';
    return '❄️ Forecast: heavy blizzard';
  }

  function lerpColor(a,b,t){
    const ah=a.match(/\w\w/g).map(x=>parseInt(x,16));
    const bh=b.match(/\w\w/g).map(x=>parseInt(x,16));
    const rh=ah.map((v,i)=>Math.round(v+(bh[i]-v)*t));
    return '#'+rh.map(v=>v.toString(16).padStart(2,'0')).join('');
  }

  function updateSky(pctPaid){
    const t = Math.max(0, Math.min(1, pctPaid/100));
    document.documentElement.style.setProperty('--sky-top', lerpColor('4A5A72','8EC5E8', t));
    document.documentElement.style.setProperty('--sky-mid', lerpColor('7C93AC','BFE0EE', t));
    document.documentElement.style.setProperty('--sky-bottom', lerpColor('E4EFF5','FDF3E0', t));
  }

  // ---------- ambient snowfall ----------
  const canvas = document.getElementById('snowCanvas');
  const ctx = canvas.getContext('2d');
  let W,H,flakes=[];
  function resizeCanvas(){ W=canvas.width=window.innerWidth; H=canvas.height=window.innerHeight; }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  function makeFlake(){ return {x:Math.random()*W, y:Math.random()*-H, r:Math.random()*2.2+1, spd:Math.random()*0.6+0.3, drift:Math.random()*0.6-0.3, o:Math.random()*0.5+0.3}; }
  function setSnowIntensity(pctRemaining){
    const target = Math.round(18 + (pctRemaining/100)*90);
    if(target > flakes.length){ while(flakes.length<target) flakes.push(makeFlake()); }
    else { flakes.length = Math.max(8,target); }
  }
  for(let i=0;i<40;i++) flakes.push(makeFlake());
  function tickSnow(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='rgba(255,255,255,0.9)';
    flakes.forEach(f=>{
      f.y+=f.spd; f.x+=f.drift;
      if(f.y>H){ f.y=-4; f.x=Math.random()*W; }
      ctx.globalAlpha=f.o;
      ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,Math.PI*2); ctx.fill();
    });
    ctx.globalAlpha=1;
    requestAnimationFrame(tickSnow);
  }
  if(!reducedMotion) tickSnow(); else { ctx.clearRect(0,0,W,H); }

  // ---------- render ----------
  function saveToStorage() {
    localStorage.setItem('snowball_debts', JSON.stringify(debts));
    localStorage.setItem('snowball_banked', banked);
    localStorage.setItem('snowball_charges', charges);
    localStorage.setItem('snowball_crushed', crushed);
    localStorage.setItem('snowball_totalSaved', totalSaved);
  }

  function render(){
    sortDebts();
    const remaining = debts.filter(d=>d.balance>0);
    const totalRemaining = debts.reduce((s,d)=>s+d.balance,0);
    const totalOriginal = debts.reduce((s,d)=>s+d.original,0);
    const pctPaid = totalOriginal>0 ? (1 - totalRemaining/totalOriginal)*100 : 0;
    const pctRemaining = 100 - pctPaid;

    document.getElementById('statTotal').textContent = fmt(totalRemaining);
    document.getElementById('statTotalSub').textContent = remaining.length + (remaining.length===1 ? ' debt left' : ' debts left');
    document.getElementById('statCharges').textContent = charges;
    document.getElementById('statSaved').textContent = fmt2(totalSaved);
    document.getElementById('statCrushed').textContent = crushed;
    document.getElementById('statCrushedSub').textContent = crushed===0 ? 'keep going' : 'nicely melted';
    document.getElementById('pileCount').textContent = charges;
    forecastEl.textContent = debts.length ? weatherLabel(pctPaid) : '❄️ Forecast: add a debt to begin';
    demoTag.textContent = isDemo ? 'Showing example debts' : 'Your own debts';
    demoTag.style.display = debts.length ? 'inline-block' : 'none';

    updateSky(debts.length ? pctPaid : 0);
    setSnowIntensity(debts.length ? pctRemaining : 100);

    const pileIcons = document.getElementById('pileIcons');
    pileIcons.innerHTML = '';
    for(let i=0;i<Math.min(charges,12);i++){
      const b = document.createElement('div'); b.className='mini-ball'; pileIcons.appendChild(b);
    }

    selectEl.innerHTML = '';
    if(remaining.length===0){
      const opt = document.createElement('option'); opt.textContent='No debts yet'; opt.disabled=true; opt.selected=true;
      selectEl.appendChild(opt);
      selectEl.disabled = true; logBtn.disabled = true;
    } else {
      selectEl.disabled = false; logBtn.disabled = false;
      remaining.forEach(d=>{
        const opt = document.createElement('option'); opt.value=d.id; opt.textContent=d.name;
        selectEl.appendChild(opt);
      });
    }

    lineEl.innerHTML = '';
    if(debts.length === 0){
      const empty = document.createElement('div');
      empty.className = 'empty-state';
      empty.textContent = 'No debts yet — add your first one above to build your snowball line.';
      lineEl.appendChild(empty);
      return;
    }

    debts.forEach((d,i)=>{
      const pct = Math.max(0, Math.min(100, (d.balance/d.original)*100));
      const paidPct = 100-pct;
      const paidOff = d.balance <= 0;
      const card = document.createElement('div');
      card.className = 'debt-card' + (paidOff ? ' paid' : '');
      card.id = 'card-' + d.id;

      const bergBg = document.createElement('div'); bergBg.className='berg-bg';
      const shimmer = document.createElement('div'); shimmer.className='shimmer';
      const cracks = buildCracks(d.id);
      cracks.querySelectorAll('path').forEach(p=>{ p.style.strokeDashoffset = paidOff ? 0 : (100 - paidPct); });

      const removeBtn = document.createElement('button');
      removeBtn.className='remove-btn'; removeBtn.setAttribute('aria-label','Remove '+d.name);
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', ()=>{ debts = debts.filter(x=>x.id!==d.id); render(); });

      const inner = document.createElement('div'); inner.className='card-inner';
      inner.innerHTML = `
        <div class="ordinal">${paidOff ? '✓' : i+1}</div>
        <div class="debt-info">
          <div class="name">${d.name}</div>
          <div class="meta">${paidOff ? 'Paid off' : fmt(d.original) + ' original · ' + d.rate + '% APR · ' + d.termMonths + 'mo left'}</div>
          <div class="ice-bar"><div class="ice-bar-fill" style="width:${pct}%"></div></div>
        </div>
        <div class="balance">${paidOff ? '£0' : fmt(d.balance)}</div>
        ${paidOff
          ? `<span class="melted-badge">melted ❄️</span>`
          : `<button class="throw-btn" data-id="${d.id}" ${charges<=0?'disabled':''}>Throw ❄️</button>`}
      `;

      card.appendChild(bergBg);
      card.appendChild(shimmer);
      card.appendChild(cracks);
      card.appendChild(removeBtn);
      card.appendChild(inner);
      lineEl.appendChild(card);
    });

    lineEl.querySelectorAll('.throw-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> throwSnowball(Number(btn.dataset.id)));
    });
  }

  // ---------- particle helpers ----------
  function spawnShards(x,y,count){
    for(let i=0;i<count;i++){
      const s = document.createElement('div'); s.className = 'shard';
      const size = 6 + Math.random()*10;
      s.style.width = size+'px'; s.style.height = size+'px';
      s.style.left = (x-size/2)+'px'; s.style.top = (y-size/2)+'px';
      document.body.appendChild(s);
      const angle = Math.random()*Math.PI*2, dist = 30 + Math.random()*70;
      const dx = Math.cos(angle)*dist, dy = Math.sin(angle)*dist - 20;
      const anim = s.animate([
        { transform:'translate(0,0) rotate(0deg)', opacity:1 },
        { transform:`translate(${dx}px, ${dy+90}px) rotate(${(Math.random()*360)|0}deg)`, opacity:0 }
      ], { duration:650+Math.random()*300, easing:'cubic-bezier(.2,.7,.3,1)' });
      anim.onfinish = ()=> s.remove();
    }
  }
  function spawnConfetti(x,y,count){
    for(let i=0;i<count;i++){
      const c = document.createElement('div'); c.className='confetti';
      const w = 4+Math.random()*3, h = 7+Math.random()*5;
      c.style.width=w+'px'; c.style.height=h+'px';
      c.style.background = CONFETTI_COLORS[(Math.random()*CONFETTI_COLORS.length)|0];
      c.style.left=x+'px'; c.style.top=y+'px';
      document.body.appendChild(c);
      const angle = Math.random()*Math.PI - Math.PI/2 - Math.PI/2*Math.random();
      const power = 60+Math.random()*90;
      const dx = Math.cos(angle)*power, upY = -60-Math.random()*60;
      const rot = (Math.random()*720-360)|0;
      const anim = c.animate([
        { transform:'translate(0,0) rotate(0deg)', opacity:1, offset:0 },
        { transform:`translate(${dx*0.6}px, ${upY}px) rotate(${rot*0.5}deg)`, opacity:1, offset:.45 },
        { transform:`translate(${dx}px, ${upY+140}px) rotate(${rot}deg)`, opacity:0, offset:1 }
      ], { duration:850+Math.random()*350, easing:'cubic-bezier(.25,.6,.3,1)' });
      anim.onfinish = ()=> c.remove();
    }
  }
  function spawnSavedLabel(x,y,amount){
    const lbl = document.createElement('div');
    lbl.className='saved-label';
    lbl.textContent = '+' + fmt2(amount) + ' interest saved';
    lbl.style.left = x+'px'; lbl.style.top = y+'px';
    document.body.appendChild(lbl);
    const anim = lbl.animate([
      { transform:'translate(-50%,-10px) scale(.9)', opacity:0, offset:0 },
      { transform:'translate(-50%,-34px) scale(1)', opacity:1, offset:.25 },
      { transform:'translate(-50%,-64px) scale(1)', opacity:1, offset:.7 },
      { transform:'translate(-50%,-84px) scale(.96)', opacity:0, offset:1 }
    ], { duration:1200, easing:'ease-out' });
    anim.onfinish = ()=> lbl.remove();
  }
  function spawnSparkle(x,y){
    const sp = document.createElement('div'); sp.className='sparkle';
    sp.style.left=(x-3)+'px'; sp.style.top=(y-3)+'px';
    document.body.appendChild(sp);
    const anim = sp.animate([{opacity:1, transform:'scale(1)'},{opacity:0, transform:'scale(.3)'}], {duration:380, easing:'ease-out'});
    anim.onfinish = ()=> sp.remove();
  }
  function pageShake(){
    if(reducedMotion) return;
    wrapEl.classList.add('shake');
    setTimeout(()=>wrapEl.classList.remove('shake'), 340);
  }
  function celebrate(){
    auroraEl.classList.add('show');
    setTimeout(()=> auroraEl.classList.remove('show'), 3500);
  }

  function throwSnowball(debtId){
    if(charges<=0) return;
    const card = document.getElementById('card-'+debtId);
    const pileArea = document.querySelector('.pile-area');
    if(!card || !pileArea) return;

    const applyResult = () => {
      charges -= 1;
      const debt = debts.find(d=>d.id===debtId);
      const chip = Math.min(15, debt.balance);
      debt.balance = Math.max(0, debt.balance - chip);
      const monthlyRate = (debt.rate/100)/12;
      const interestSaved = chip * monthlyRate * debt.termMonths;
      totalSaved += interestSaved;
      const justCrushed = debt.balance === 0;
      if(justCrushed) crushed += 1;
      return { justCrushed, interestSaved };
    };

    if(reducedMotion){
      const end = card.getBoundingClientRect();
      const { justCrushed, interestSaved } = applyResult();
      render();
      pageShake();
      spawnConfetti(end.left+end.width*.7, end.top+end.height/2, 10);
      spawnSavedLabel(end.left+end.width*.7, end.top+end.height/2, interestSaved);
      if(justCrushed) { celebrate(); spawnShards(end.left+end.width*.7, end.top+end.height/2, 10); }
      return;
    }

    const start = pileArea.getBoundingClientRect();
    const end = card.getBoundingClientRect();
    const ball = document.createElement('div'); ball.className = 'flying-ball';
    const sx = start.left+start.width/2, sy = start.top+18;
    const tx = end.left + end.width*0.72, ty = end.top + end.height/2;
    ball.style.left = (sx-11)+'px'; ball.style.top = (sy-11)+'px';
    document.body.appendChild(ball);

    const midX = sx + (tx-sx)*0.5, midY = Math.min(sy,ty) - 90;

    const anim = ball.animate([
      { transform:'translate(0,0) rotate(0deg) scale(1)', offset:0 },
      { transform:`translate(${midX-sx}px, ${midY-sy}px) rotate(260deg) scale(1)`, offset:.5 },
      { transform:`translate(${tx-sx}px, ${ty-sy}px) rotate(520deg) scale(.75)`, offset:1 }
    ], { duration:560, easing:'cubic-bezier(.32,.6,.35,1)' });

    [0.32,0.62,0.85].forEach(t=>{
      setTimeout(()=>{
        const bx = ball.getBoundingClientRect();
        spawnSparkle(bx.left+11, bx.top+11);
      }, 560*t);
    });

    anim.onfinish = () => {
      ball.remove();
      const { justCrushed, interestSaved } = applyResult();
      render();
      const freshCard = document.getElementById('card-'+debtId);
      if(freshCard){
        freshCard.classList.add('hit');
        setTimeout(()=> freshCard.classList.remove('hit'), 420);
      }
      pageShake();
      spawnShards(tx, ty, justCrushed ? 14 : 6);
      spawnConfetti(tx, ty, justCrushed ? 20 : 12);
      spawnSavedLabel(tx, ty, interestSaved);
      if(justCrushed) celebrate();
    };
  }

  document.getElementById('logBtn').addEventListener('click', ()=>{
    const id = Number(selectEl.value);
    const amt = Math.max(0, Math.floor(Number(amountEl.value) || 0));
    if(!id || amt<=0) return;
    const debt = debts.find(d=>d.id===id);
    if(!debt) return;
    const wasAlive = debt.balance > 0;
    debt.balance = Math.max(0, debt.balance - amt);
    if(wasAlive && debt.balance === 0) crushed += 1;
    banked += amt;
    while(banked >= 5){ banked -= 5; charges += 1; }
    amountEl.value = '';
    render();
  });

  document.getElementById('addDebtBtn').addEventListener('click', ()=>{
    const nameEl = document.getElementById('inName');
    const balEl = document.getElementById('inBalance');
    const rateEl = document.getElementById('inRate');
    const termEl = document.getElementById('inTerm');
    const name = nameEl.value.trim();
    const balance = Math.round(Number(balEl.value));
    const rate = Number(rateEl.value);
    const term = Math.round(Number(termEl.value));
    if(!name || !(balance>0) || isNaN(rate) || rate<0 || !(term>0)) return;
    debts.push({ id: nextId++, name, balance, original: balance, rate, termMonths: term });
    nameEl.value=''; balEl.value=''; rateEl.value=''; termEl.value='';
    render();
  });

  document.getElementById('clearBtn').addEventListener('click', ()=>{
    if(!confirm('Clear all debts and stats to start fresh?')) return;
    debts = []; banked = 0; charges = 0; crushed = 0; totalSaved = 0; isDemo = false;
    render();
  });

  render();
</script>
</body>
</html>
