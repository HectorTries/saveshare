<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Snowball — bury your debt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  @property --sky-top   { syntax: '<color>'; inherits: true; initial-value: #4A5A72; }
  @property --sky-mid   { syntax: '<color>'; inherits: true; initial-value: #7C93AC; }
  @property --sky-bottom{ syntax: '<color>'; inherits: true; initial-value: #E4EFF5; }

  :root{
    --snow-panel:#FFFFFF;
    --frost-blue:#3E92CC;
    --frost-blue-deep:#2A6FA0;
    --deep-navy:#16283D;
    --navy-soft:#4A6178;
    --mint-melt:#5FC9A8;
    --ember:#FF6B4A;
    --ember-deep:#E5502F;
    --gold:#F2B84B;
    --frost-line:#D3E4EE;
    --frost-line-soft:#E4EFF5;
    --radius:20px;
    --sky-top:#4A5A72; --sky-mid:#7C93AC; --sky-bottom:#E4EFF5;
    transition: --sky-top .9s ease, --sky-mid .9s ease, --sky-bottom .9s ease;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{min-height:100vh; color:var(--deep-navy); font-family:'Manrope',sans-serif; position:relative; overflow-x:hidden;}
  #sky{position:fixed; inset:0; z-index:-3; background:linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 45%, var(--sky-bottom) 100%);}
  #mountains{position:fixed; left:0; right:0; bottom:0; z-index:-2; width:100%; height:38vh; min-height:220px; pointer-events:none;}
  #snowCanvas{position:fixed; inset:0; z-index:-1; pointer-events:none;}
  #aurora{
    position:fixed; top:0; left:0; right:0; height:40vh; z-index:-1; pointer-events:none; opacity:0; mix-blend-mode:screen;
    background:linear-gradient(120deg, rgba(95,201,168,.5), rgba(62,146,204,.35), rgba(255,182,140,.4));
    filter:blur(30px); transition:opacity 1.2s ease;
  }
  #aurora.show{opacity:.55; animation:auroraDrift 3.5s ease-in-out;}
  @keyframes auroraDrift{0%{transform:translateY(-12px) scale(.96);}50%{transform:translateY(4px) scale(1.02);}100%{transform:translateY(0) scale(1);}}

  .wrap{max-width:960px;margin:0 auto;padding:32px 20px 90px;position:relative;transition:transform .12s ease;}
  .wrap.shake{animation:pageShake .32s ease;}
  @keyframes pageShake{0%,100%{transform:translateX(0);}25%{transform:translateX(-3px);}50%{transform:translateX(3px);}75%{transform:translateX(-2px);}}

  .brand{display:flex;align-items:center;gap:12px;margin-bottom:4px;}
  .mark{width:36px;height:36px;position:relative;flex-shrink:0;}
  .mark span{position:absolute;border-radius:50%;background:linear-gradient(160deg,#fff,var(--frost-blue));box-shadow:inset -2px -3px 4px rgba(42,111,160,.35);}
  .mark span:nth-child(1){width:36px;height:36px;bottom:0;left:0;}
  .mark span:nth-child(2){width:25px;height:25px;bottom:21px;left:5.5px;}
  .mark span:nth-child(3){width:14px;height:14px;bottom:38px;left:11px;}
  h1{font-family:'Baloo 2',sans-serif;font-weight:700;font-size:29px;margin:0;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.15);}
  .tagline{color:rgba(255,255,255,.85);font-size:15px;margin:2px 0 0;text-shadow:0 1px 2px rgba(0,0,0,.1);}
  .forecast{display:inline-flex;align-items:center;gap:6px;margin-top:14px;background:rgba(255,255,255,.85);backdrop-filter:blur(6px);border-radius:20px;padding:6px 14px;font-size:12.5px;font-weight:700;color:var(--frost-blue-deep);border:1px solid rgba(255,255,255,.6);}

  .hero{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:22px 0 30px;}
  @media(max-width:760px){.hero{grid-template-columns:1fr 1fr;}}
  .stat{background:rgba(255,255,255,.9);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.7);border-radius:var(--radius);padding:16px 18px;}
  .stat-label{font-size:11.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--navy-soft);font-weight:700;margin-bottom:7px;}
  .stat-value{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:23px;color:var(--deep-navy);}
  .stat-value.ember{color:var(--ember-deep);}
  .stat-value.mint{color:var(--mint-melt);filter:brightness(.8);}
  .stat-value.gold{color:#B5842A;}
  .stat-sub{font-size:12px;color:var(--navy-soft);margin-top:4px;}

  .section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:6px;}
  .section-head h2{font-family:'Baloo 2',sans-serif;font-size:19px;margin:0;color:var(--deep-navy);}
  .section-head p{margin:0;font-size:13px;color:var(--navy-soft);}

  /* ---------- setup panel ---------- */
  .setup-panel{background:rgba(255,255,255,.92);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.7);border-radius:var(--radius);padding:20px 22px;margin-bottom:32px;}
  .setup-panel h3{font-family:'Baloo 2',sans-serif;font-size:17px;margin:0 0 4px;}
  .setup-panel .hint{font-size:13px;color:var(--navy-soft);margin:0 0 16px;line-height:1.5;}
  .setup-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr auto;gap:10px;align-items:end;}
  @media(max-width:780px){.setup-grid{grid-template-columns:1fr 1fr;}}
  .field label{display:block;font-size:11.5px;font-weight:700;color:var(--navy-soft);margin-bottom:5px;}
  .field input{width:100%;font-family:'Manrope',sans-serif;font-size:14px;border:1.5px solid var(--frost-line);border-radius:10px;padding:9px 11px;background:#fff;color:var(--deep-navy);}
  .field input:focus{outline:2px solid var(--frost-blue);outline-offset:1px;border-color:var(--frost-blue);}
  .add-btn{background:var(--frost-blue);color:#fff;border:none;border-radius:10px;padding:10px 16px;font-weight:700;font-size:13.5px;cursor:pointer;font-family:'Manrope',sans-serif;box-shadow:0 3px 0 var(--frost-blue-deep);white-space:nowrap;height:38px;}
  .add-btn:active{transform:translateY(2px);box-shadow:0 1px 0 var(--frost-blue-deep);}
  .setup-foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px;flex-wrap:wrap;gap:8px;}
  .clear-link{background:none;border:none;color:var(--navy-soft);font-size:12.5px;text-decoration:underline;cursor:pointer;font-family:'Manrope',sans-serif;padding:0;}
  .clear-link:hover{color:var(--ember-deep);}
  .demo-tag{font-size:11.5px;background:var(--frost-line-soft);color:var(--frost-blue-deep);border-radius:20px;padding:4px 10px;font-weight:700;}

  /* ---------- iceberg cards ---------- */
  .line{display:flex;flex-direction:column;gap:16px;margin-bottom:38px;}
  .empty-state{background:rgba(255,255,255,.85);border:1.5px dashed rgba(74,97,120,.35);border-radius:var(--radius);padding:28px 22px;text-align:center;color:var(--navy-soft);font-size:14px;}
  .debt-card{position:relative; padding:18px 22px; overflow:visible; transition:transform .18s ease;}
  .debt-card .berg-bg{position:absolute; inset:0; border-radius:var(--radius); background:linear-gradient(160deg,#ffffff 0%, #EAF6FB 55%, #DCEEF6 100%); clip-path:polygon(2% 14%, 13% 2%, 87% 0%, 98% 11%, 100% 48%, 96% 89%, 85% 100%, 13% 97%, 0% 86%); box-shadow:0 6px 18px rgba(30,70,110,.10), inset 0 0 0 1px rgba(255,255,255,.6);}
  .debt-card .shimmer{position:absolute; inset:0; border-radius:var(--radius); clip-path:inherit; background:linear-gradient(115deg, transparent 40%, rgba(255,255,255,.65) 50%, transparent 60%); background-size:250% 250%; animation:shimmer 7s ease-in-out infinite; opacity:.7; mix-blend-mode:screen; pointer-events:none;}
  .debt-card.paid .berg-bg{background:linear-gradient(160deg,#EAFBF6,#D7F3E9);}
  @keyframes shimmer{0%{background-position:-40% -40%;}50%{background-position:140% 140%;}100%{background-position:-40% -40%;}}
  .cracks{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}
  .cracks path{fill:none; stroke:rgba(74,97,120,.55); stroke-width:1.4; stroke-linecap:round; stroke-dasharray:100 100; transition:stroke-dashoffset .7s cubic-bezier(.2,.7,.3,1);}

  .remove-btn{
    position:absolute; top:10px; right:14px; z-index:2; width:22px;height:22px;border-radius:50%;
    background:rgba(74,97,120,.1); border:none; color:var(--navy-soft); font-size:13px; font-weight:700;
    cursor:pointer; display:flex;align-items:center;justify-content:center;line-height:1;
  }
  .remove-btn:hover{background:rgba(229,80,47,.15); color:var(--ember-deep);}

  .card-inner{position:relative;z-index:1;display:grid;grid-template-columns:34px 1fr auto auto;align-items:center;gap:16px;}
  .ordinal{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13px;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(62,146,204,.12);color:var(--frost-blue-deep);}
  .debt-info .name{font-weight:700;font-size:15.5px;}
  .debt-info .meta{font-size:12px;color:var(--navy-soft);margin-top:2px;}
  .ice-bar{position:relative;height:8px;border-radius:6px;background:rgba(74,97,120,.12);overflow:hidden;margin-top:9px;width:100%;}
  .ice-bar-fill{position:absolute;left:0;top:0;bottom:0;border-radius:6px;background:linear-gradient(90deg,var(--mint-melt),#8fe0c4);transition:width .6s cubic-bezier(.2,.8,.2,1);}
  .balance{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:16px;text-align:right;min-width:88px;}
  .throw-btn{font-family:'Manrope',sans-serif;font-weight:700;font-size:13px;background:var(--ember);color:#fff;border:none;border-radius:12px;padding:9px 14px;cursor:pointer;white-space:nowrap;box-shadow:0 3px 0 var(--ember-deep);transition:transform .08s ease, box-shadow .08s ease;}
  .throw-btn:active{transform:translateY(2px);box-shadow:0 1px 0 var(--ember-deep);}
  .throw-btn:disabled{background:rgba(74,97,120,.15);color:var(--navy-soft);box-shadow:none;cursor:not-allowed;}
  .melted-badge{font-size:12px;font-weight:700;color:var(--mint-melt);filter:brightness(.75);background:#EAFBF4;border:1px solid #CDEFE2;border-radius:20px;padding:5px 10px;}

  .debt-card.hit .berg-bg{animation:jolt .38s ease;}
  @keyframes jolt{0%,100%{transform:translate(0,0) rotate(0);}20%{transform:translate(-3px,1px) rotate(-.3deg);}45%{transform:translate(3px,-1px) rotate(.3deg);}70%{transform:translate(-2px,0) rotate(-.15deg);}}
  .debt-card.paid{opacity:.7;}

  .actions{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;}
  @media(max-width:680px){.actions{grid-template-columns:1fr;}}
  .panel{background:rgba(255,255,255,.92);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.7);border-radius:var(--radius);padding:20px;}
  .panel h3{font-family:'Baloo 2',sans-serif;font-size:16px;margin:0 0 4px;}
  .panel .hint{font-size:12.5px;color:var(--navy-soft);margin:0 0 16px;}
  label{display:block;font-size:12.5px;font-weight:700;color:var(--navy-soft);margin-bottom:6px;}
  select, input[type=number]{width:100%;font-family:'Manrope',sans-serif;font-size:14.5px;border:1.5px solid var(--frost-line);border-radius:10px;padding:10px 12px;margin-bottom:14px;background:#fff;color:var(--deep-navy);}
  select:focus, input:focus{outline:2px solid var(--frost-blue);outline-offset:1px;border-color:var(--frost-blue);}
  select:disabled{opacity:.6;}
  .log-btn{width:100%;background:var(--frost-blue);color:#fff;border:none;border-radius:12px;padding:12px;font-weight:700;font-size:14.5px;cursor:pointer;font-family:'Manrope',sans-serif;box-shadow:0 3px 0 var(--frost-blue-deep);}
  .log-btn:disabled{background:rgba(74,97,120,.2);box-shadow:none;cursor:not-allowed;}
  .log-btn:active{transform:translateY(2px);box-shadow:0 1px 0 var(--frost-blue-deep);}

  .pile-area{position:relative;min-height:170px;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  .pile-count{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:38px;color:var(--frost-blue-deep);}
  .pile-caption{font-size:12.5px;color:var(--navy-soft);margin-top:2px;text-align:center;}
  .pile-icons{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap;justify-content:center;max-width:220px;}
  .mini-ball{width:16px;height:16px;border-radius:50%;background:radial-gradient(circle at 35% 30%, #fff, var(--frost-blue) 75%);box-shadow:inset -1px -2px 2px rgba(42,111,160,.4);}

  .flying-ball{position:fixed;width:22px;height:22px;border-radius:50%;background:radial-gradient(circle at 35% 30%, #fff, var(--frost-blue) 75%);box-shadow:inset -2px -3px 3px rgba(42,111,160,.45), 0 3px 8px rgba(0,0,0,.18);pointer-events:none;z-index:999;}
  .sparkle{position:fixed;width:6px;height:6px;border-radius:50%;background:#fff;box-shadow:0 0 6px 1px rgba(255,255,255,.8);pointer-events:none;z-index:998;}
  .shard{position:fixed;pointer-events:none;z-index:997;background:linear-gradient(160deg,#fff,#BEE0EF);clip-path:polygon(50% 0%,0% 100%,100% 100%);box-shadow:0 2px 5px rgba(30,70,110,.15);}
  .confetti{position:fixed;pointer-events:none;z-index:997;border-radius:1px;}
  .saved-label{
    position:fixed;pointer-events:none;z-index:1000;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:15px;
    color:#B5842A; text-shadow:0 1px 0 rgba(255,255,255,.9), 0 0 6px rgba(255,255,255,.7); white-space:nowrap;
  }

  footer{margin-top:34px;font-size:12.5px;color:var(--navy-soft);line-height:1.6;border-top:1px solid rgba(74,97,120,.2);padding-top:16px;}
  footer b{color:var(--deep-navy);}

  @media (prefers-reduced-motion: reduce){
    .debt-card.hit .berg-bg{animation:none;}
    .shimmer{animation:none;}
    .wrap.shake{animation:none;}
    #aurora.show{animation:none;}
  }
</style>
</head>
